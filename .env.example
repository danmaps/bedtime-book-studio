# ============================================================================
# Bedtime Book Studio — Local User Configuration (.env)
# ============================================================================
# Copy this file to `.env` or run:
#   ./setup.sh
#   python3 scripts/book_studio.py onboard
#
# Your `.env` file and `local_profile/` folder are gitignored so your personal
# photos, character details, and family defaults never leave your machine.
# ============================================================================

# Set to "true" once onboarding has been completed
ONBOARDING_COMPLETE="false"

# ----------------------------------------------------------------------------
# 1. Main Character Defaults (Photo and/or Text Description)
# ----------------------------------------------------------------------------
# Name or nickname of the main character used by default in new books
MAIN_CHARACTER_NAME=""

# Age (e.g. "4", "6")
MAIN_CHARACTER_AGE=""

# Physical appearance description (hair, eyes, skin tone, glasses, etc.)
# Used alongside reference photos (or on its own if no photo is provided)
MAIN_CHARACTER_DESCRIPTION=""

# Default outfit for continuity across pages (can be overridden per book)
MAIN_CHARACTER_OUTFIT=""

# Comma-separated paths to reference photo(s) of the main character (optional)
# During onboarding, photos are copied into `./local_profile/references/`
MAIN_CHARACTER_PHOTO_PATHS=""

# ----------------------------------------------------------------------------
# 2. Supporting Cast & Recurring Props (Optional)
# ----------------------------------------------------------------------------
# Semicolon-separated descriptions of family members, pets, or friends
# Example: "Mom: glasses, curly brown hair; Max: fluffy golden retriever"
SUPPORTING_CHARACTERS=""

# Favorite real-world toys or props that often appear in stories
# Example: "Small wooden tricycle with green wheels; plush grey elephant"
RECURRING_PROPS=""

# ----------------------------------------------------------------------------
# 3. Art Style & Book Format Defaults
# ----------------------------------------------------------------------------
DEFAULT_ART_STYLE="Children's picture-book illustration with hand-drawn warm ink outlines and soft flat watercolor washes, warm natural daylight, expressive friendly faces, 4:3 horizontal landscape composition, no text or letters in the artwork."

# Default book mode: "lift-the-flap" (Reality flap lifts to reveal Imaginary world) or "standard"
DEFAULT_BOOK_MODE="lift-the-flap"

# Default number of story pages per book (excluding cover and end page)
DEFAULT_PAGE_COUNT="12"

# ----------------------------------------------------------------------------
# 4. Output & Local Device Hosting Defaults
# ----------------------------------------------------------------------------
# Directory where generated books (and single-file HTML books) are saved
BOOKS_OUTPUT_DIR="./books"

# Port for the built-in local device web server (accessible on localhost & home Wi-Fi)
LOCAL_SERVER_PORT="8765"

# ----------------------------------------------------------------------------
# 5. Optional Self-Hosting / Custom Web Server Copy (Leave blank by default)
# ----------------------------------------------------------------------------
# If you run your own static web server (Nginx, Caddy, Cloudflare Pages folder, etc.),
# set PUBLISH_WEB_ROOT to automatically copy published books to `<PUBLISH_WEB_ROOT>/<slug>`
PUBLISH_WEB_ROOT=""

# Optional public base URL matching PUBLISH_WEB_ROOT (e.g. "https://books.example.com")
PUBLISH_BASE_URL=""
