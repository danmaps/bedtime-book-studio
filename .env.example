# ============================================================================
# Bedtime Book Studio — Local User Configuration (.env)
# Copy this file to `.env` or run `python3 scripts/book_studio.py onboard`
# (or ask your AI agent to run onboarding) to populate your defaults.
# ============================================================================

ONBOARDING_COMPLETE="true"

# --- Main Character Defaults ---
MAIN_CHARACTER_NAME="Leo"
MAIN_CHARACTER_AGE="4"
MAIN_CHARACTER_DESCRIPTION="4-year-old child with warm brown eyes, curly hair, rosy cheeks, and an expressive, curious smile."
MAIN_CHARACTER_OUTFIT="Yellow striped T-shirt, denim overalls, and red sneakers."
# Comma-separated absolute paths to local reference photos (optional; can use photo, text, or both)
MAIN_CHARACTER_PHOTOS=""

# --- Supporting Cast & Recurring Visual Anchors (Optional) ---
SUPPORTING_CHARACTERS="Parent with glasses and warm smile; friendly golden retriever dog."
RECURRING_PROPS="A small red wooden toy train that appears in the corner of every page."

# --- Illustration Style Defaults ---
DEFAULT_ART_STYLE="Clean hand-drawn dark-charcoal ink linework with gentle flat watercolor and gouache coloring on a clean warm-cream paper texture. Restrained, cozy storybook palette. No sepia/yellow cast, no photorealism, and ZERO text, letters, or numbers baked into the image. 4:3 landscape (1200x896) horizontal composition."
# Optional comma-separated paths to style reference images
STYLE_REFERENCE_IMAGES=""

# --- Book Format Defaults ---
# Mode: "lift-the-flap" (Reality flap lifts to reveal Imaginary scene on every page except cover) or "standard"
DEFAULT_BOOK_MODE="lift-the-flap"
DEFAULT_PAGE_COUNT="12"
BOOKS_OUTPUT_DIR="./books"

# --- Optional Unlisted Web Publishing & Docker Hosting ---
# If PUBLISH_WEB_ROOT is set, `publish_book` copies only the static reader files
# (index.html with noindex/nofollow, styles.css, script.js, and assets/*.{png,webp})
# to ${PUBLISH_WEB_ROOT}/<slug>/ without modifying any main site pages.
PUBLISH_WEB_ROOT=""
PUBLISH_BASE_URL=""

# Optional Docker Compose static nginx server bind settings
DOCKER_BIND_IP="127.0.0.1"
DOCKER_START_PORT="4180"
